# ==============================================================================
# OpenCode Multi-Account API Keys
# ==============================================================================
# Зарегистрируй 3+ аккаунта на opencode.ai (желательно с разных IP/браузерных профилей)
# и вставь полученные API-ключи ниже:

OPENCODE_KEY_1=sk-
OPENCODE_KEY_2=sk-
OPENCODE_KEY_3=sk-
# OPENCODE_KEY_4=sk-
# OPENCODE_KEY_5=sk-

# ==============================================================================
# Настройки LiteLLM Proxy
# ==============================================================================
PROXY_HOST=127.0.0.1
PROXY_PORT=4000

# Мастер-ключ для защиты самого прокси (можно оставить dummy для локального использования)
PROXY_MASTER_KEY=sk-litellm-master-key
